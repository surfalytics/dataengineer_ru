    int month
    string month_name
    string day_name
    boolean is_weekend
  }
  DIM_CUSTOMER {
    int customer_key PK "surrogate key"
    int customer_id "natural key"
    string customer_name
    string city
    string segment
  }
  DIM_PRODUCT {
    int product_key PK "surrogate key"
    int product_id "natural key"
    string sku
    string product_name
    string brand
    string category_name "денормализовано"
  }
  DIM_STORE {
    int store_key PK "surrogate key"
    int store_id "natural key"
    string store_name
    string city
    string region
    string store_type
  }
