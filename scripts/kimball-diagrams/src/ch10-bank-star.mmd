  FACT_ACCOUNT_SNAPSHOT {
    int month_key FK
    int account_key FK
    int household_key FK
    int profile_key FK
    decimal ending_balance
    decimal deposit_amount
    decimal withdrawal_amount
    int txn_count
  }
  FACT_CHECKING_SNAPSHOT {
    int month_key FK
    int account_key FK
    decimal ending_balance "same as supertype"
    decimal deposit_amount
    decimal withdrawal_amount
    int txn_count
    decimal overdraft_fee "checking only"
    int atm_withdrawal_count "checking only"
  }
  DIM_ACCOUNT {
    int account_key PK
    string account_number "natural key"
    string product_type
    string branch
  }
  DIM_ACCOUNT_PROFILE {
    int profile_key PK
    string balance_band
    string activity_status
  }
  BRIDGE_ACCOUNT_CUSTOMER {
    int account_key FK
    int customer_key FK
    decimal weighting_factor
  }
  DIM_CUSTOMER {
    int customer_key PK
    string customer_name
  }
  DIM_HOUSEHOLD {
    int household_key PK
    string household_name
  }
  DIM_DATE {
    int month_key PK
