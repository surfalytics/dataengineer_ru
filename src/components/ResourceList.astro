---
// Группа ресурсов: подзаголовок и простой список.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<section class="rl not-content">
  {title && <h3 class="rl-title">{title}</h3>}
  <ul class="rl-items"><slot /></ul>
</section>

<style>
  .rl {
    margin-block: 2rem 0;
  }
  .rl-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.25rem;
  }
  .rl-items {
    margin: 0;
    padding: 0;
  }
  .rl-items :global(.res[hidden]),
  .rl[hidden] {
    display: none;
  }
</style>
