---
// Минималистичная шапка в одну строку: название · разделы · поиск · тема.
// На мобильных разделы скрыты — там их показывает меню (плагин sidebar-topics).
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { topics } from '../nav.mjs';

const path = Astro.url.pathname;
const isCurrent = (t: (typeof topics)[number]) => t.match.some((p) => path.startsWith(p));
// Короткие подписи для экранов 800–1600 px: там все разделы с полными подписями не влезают в одну строку.
const SHORT: Record<string, string> = { 'База знаний': 'Знания', 'Конспекты книг': 'Книги', 'Конспекты лекций': 'Лекции', 'Подготовка к интервью': 'Интервью' };
---

<!-- Яндекс Метрика без JavaScript. Тег <noscript> с картинкой нельзя ставить в <head>, поэтому он здесь. -->
<noscript><div><img src="https://mc.yandex.ru/watch/114151925" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<div class="mh">
  <div class="mh-title"><SiteTitle /></div>
  <nav class="mh-nav" aria-label="Разделы портала">
    {
      topics.map((t) => (
        <a href={t.link} class:list={{ current: isCurrent(t) }} aria-current={isCurrent(t) ? 'page' : undefined}>
          {SHORT[t.label] ? (
            <>
              <span class="full">{t.label}</span>
              <span class="short">{SHORT[t.label]}</span>
            </>
          ) : (
            t.label
          )}
        </a>
      ))
    }
  </nav>
  <div class="mh-search"><Search /></div>
  <div class="mh-right">
    <SocialIcons />
    <ThemeSelect />
  </div>
</div>

<style>
  .mh {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }
  .mh-title {
    min-width: 0;
    overflow: clip;
  }
  .mh-nav,
  .mh-right {
    display: none;
  }
  .mh-search {
    margin-inline-start: auto;
  }
  .mh-nav .short {
    display: none;
  }
  @media (min-width: 50rem) {
    /* Логотип не сжимается. Если места мало, сжимается ряд разделов: лишнее прокручивается вбок. */
    .mh-title {
      flex-shrink: 0;
    }
    .mh-nav {
      display: flex;
      gap: 1.5rem;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .mh-nav::-webkit-scrollbar {
      display: none;
    }
    .mh-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }
  /* 800–1600 px: меньше отступы и короткие подписи, чтобы все разделы влезли в одну строку. */
  @media (min-width: 50rem) and (max-width: 99.99rem) {
    .mh,
    .mh-nav {
      gap: 1rem;
    }
    .mh-nav .full {
      display: none;
    }
    .mh-nav .short {
      display: inline;
    }
  }
  @media (min-width: 50rem) and (max-width: 76.99rem) {
    .mh,
    .mh-nav {
      gap: 0.75rem;
    }
  }
  /* 1600–1840 px: полные подписи, отступы чуть меньше. */
  @media (min-width: 100rem) and (max-width: 114.99rem) {
    .mh,
    .mh-nav {
      gap: 1rem;
    }
  }
  /* 800–1184 px: разделы не влезают. Край ряда гаснет: видно, что ряд прокручивается. */
  @media (min-width: 50rem) and (max-width: 73.99rem) {
    .mh-nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    }
  }
  .mh-nav a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }
  .mh-nav a:hover,
  .mh-nav a.current {
    color: var(--sl-color-white);
  }
  .mh-nav a.current {
    font-weight: 600;
  }
</style>
