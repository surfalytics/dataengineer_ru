---
// Карусель конспектов книг на главной, с вкладками по разделам.
// Книги и разделы берутся из src/nav.mjs ("Конспекты книг"), порядок тот же.
// Обложка: public/assets/book-covers/<slug>.jpg (240px, JPEG). Если файла нет — рисуем обложку из названия.
// Автор: поле author в index.md книги.
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { topics } from '../nav.mjs';

type Book = { slug: string; title: string; author?: string; href: string; cover?: string; pages: number; group: string };

const docs = await getCollection('docs');
const topic = topics.find((t: any) => t.link === '/book-summaries/');
const groups: { label: string; books: Book[] }[] = [];

for (const g of topic?.items ?? []) {
  if (!g.items) continue; // пропускаем "Обзор"
  const books: Book[] = [];
  for (const b of g.items) {
    const dir: string | undefined = b.items?.[0]?.autogenerate?.directory;
    if (!dir) continue;
    const slug = dir.split('/').pop()!;
    const index = docs.find((d) => d.id === dir);
    if (!index) continue;
    const coverPath = `/assets/book-covers/${slug}.jpg`;
    books.push({
      slug,
      title: b.label,
      author: index.data.author,
      href: `/${dir}/`,
      cover: existsSync(`public${coverPath}`) ? coverPath : undefined,
      pages: docs.filter((d) => d.id.startsWith(dir + '/')).length,
      group: g.label,
    });
  }
  if (books.length) groups.push({ label: g.label, books });
}
const all = groups.flatMap((g) => g.books);
---

<div class="bc not-content" data-bc>
  <div class="bc-bar">
    <div class="bc-tabs" role="tablist" aria-label="Разделы конспектов">
      <button type="button" role="tab" aria-selected="true" data-group="">
        Все <span>{all.length}</span>
      </button>
      {
        groups.map((g) => (
          <button type="button" role="tab" aria-selected="false" data-group={g.label}>
            {g.label} <span>{g.books.length}</span>
          </button>
        ))
      }
    </div>
    <div class="bc-nav">
      <button type="button" class="bc-arrow" data-dir="-1" aria-label="Назад">←</button>
      <button type="button" class="bc-arrow" data-dir="1" aria-label="Вперёд">→</button>
    </div>
  </div>

  <ul class="bc-track">
    {
      all.map((b) => (
        <li class="bc-item" data-group={b.group}>
          <a class="bc-card" href={b.href}>
            {b.cover ? (
              <img class="bc-cover" src={b.cover} alt={`Обложка книги ${b.title}`} width="240" height="320" loading="lazy" decoding="async" />
            ) : (
              <span class="bc-cover bc-fallback">{b.title}</span>
            )}
            <span class="bc-title">{b.title}</span>
            {b.author && <span class="bc-meta">{b.author}</span>}
            <span class="bc-meta">{b.pages} стр.</span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="bc-all" href="/book-summaries/">Все конспекты →</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bc]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.bc-track')!;
    const tabs = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const items = root.querySelectorAll<HTMLElement>('.bc-item');
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.bc-arrow');

    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const g = tab.dataset.group;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        items.forEach((i) => (i.hidden = !!g && i.dataset.group !== g));
        track.scrollTo({ left: 0 });
        update();
      }),
    );

    [prev, next].forEach((btn) =>
      btn.addEventListener('click', () => {
        const step = Math.max(track.clientWidth * 0.8, 160);
        track.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: 'smooth' });
      }),
    );

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .bc {
    margin-top: 1rem;
  }
  .bc-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .bc-tabs {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bc-tabs::-webkit-scrollbar {
    display: none;
  }
  .bc-tabs button {
    flex-shrink: 0;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
    white-space: nowrap;
  }
  .bc-tabs button span {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .bc-tabs button:hover {
    color: var(--sl-color-white);
  }
  .bc-tabs button[aria-selected='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .bc-nav {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .bc-arrow {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .bc-arrow:hover:not(:disabled) {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
  .bc-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .bc-track {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .bc-track::-webkit-scrollbar {
    display: none;
  }
  .bc-item {
    flex: 0 0 9.5rem;
    scroll-snap-align: start;
  }
  .bc-item[hidden] {
    display: none;
  }
  .bc-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  .bc-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: 4px;
    border: 1px solid var(--line);
    margin-bottom: 0.4rem;
    transition: transform 0.15s;
  }
  .bc-fallback {
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.2;
  }
  .bc-card:hover .bc-cover {
    transform: translateY(-3px);
  }
  .bc-title {
    font-weight: 600;
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .bc-card:hover .bc-title {
    color: var(--sl-color-accent);
  }
  .bc-meta {
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--muted);
  }
  .bc-all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  @media (max-width: 40rem) {
    .bc-nav {
      display: none;
    }
    .bc-item {
      flex-basis: 8rem;
    }
  }
</style>
