---
// Дорожная карта инженера данных: 4 уровня. Junior нет: его темы входят в Middle, практика — через пет-проекты, у каждого — темы со ссылками на базу знаний.
const levels = [
  {
    n: 0,
    name: 'Основы',
    note: 'Без этого никуда',
    topics: [
      ['SQL', '/processing/sql/'],
      ['Python и языки', '/tools/coding/'],
      ['CLI и IDE', '/tools/cli-ide/'],
      ['Git', '/tools/git/'],
      ['AI-инструменты', '/ai/ai-tools/'],
      [
        'Агентная разработка',
        null,
        [
          ['Claude Code', '/ai/claude-code-101/'],
          ['Codex', '/ai/codex-101/'],
          ['Pi и OpenCode', '/ai/open-agents-101/'],
        ],
      ],
    ],
  },
  {
    n: 1,
    name: 'Middle',
    note: 'Пайплайн от источника до дашборда',
    topics: [
      ['Хранилища данных', '/processing/dw/'],
      ['Моделирование данных', '/processing/data-modelling/'],
      ['ETL / ELT', '/processing/etl/'],
      ['BI-инструменты', '/processing/bi/'],
      ['Работа с API', '/tools/api/'],
      ['Облака', '/tools/cloud/'],
      ['Apache Spark', '/processing/spark/'],
      ['Big Data', '/processing/bigdata/'],
    ],
  },
  {
    n: 2,
    name: 'Senior',
    note: 'Архитектура и команда',
    topics: [
      ['Streaming', '/processing/streaming/'],
      ['DevOps и IaC (Terraform, Bicep)', '/tools/devops/#инфраструктура-как-код'],
      ['Data Quality и Observability', '/processing/data-quality/#data-observability'],
      ['Лидерство и менторство', '/community/management/'],
      ['Влияние на бизнес (Impact)', '/community/management/#влияние-на-бизнес-impact'],
    ],
  },
  {
    n: 3,
    name: 'Senior+',
    note: 'Staff и Principal',
    topics: [
      ['Техническая стратегия', '/career/staff-principal/#что-изучать'],
      ['Архитектура данных компании', '/career/staff-principal/#что-изучать'],
      ['Design docs и RFC', '/career/staff-principal/#что-изучать'],
      ['Влияние без полномочий', '/career/staff-principal/#что-изучать'],
      ['Staff и Principal: как вырасти', '/career/staff-principal/'],
    ],
  },
];
---

<ol class="roadmap not-content">
  {
    levels.map((l) => (
      <li class="lvl">
        <div class="lvl-head">
          <span class="lvl-n">0{l.n}</span>
          <div>
            <div class="lvl-name">{l.name}</div>
            <div class="lvl-note">{l.note}</div>
          </div>
        </div>
        <ul>
          {l.topics.map(([t, href, subs]) => (
            <li>
              {href ? <a href={href}>{t}</a> : <span>{t}</span>}
              {subs && (
                <div class="subs">
                  {subs.map(([st, sh]) => (
                    <a href={sh}>{st}</a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .roadmap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }
  .lvl {
    border-top: 2px solid var(--sl-color-white);
    padding-top: 0.9rem;
  }
  .lvl:not(:first-child) {
    border-top-color: var(--line);
  }
  .lvl-head {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .lvl-n {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .lvl-name {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .lvl-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  ul a,
  ul span {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .subs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    margin-top: 0.15rem;
    padding-left: 0.6rem;
  }
  .subs a {
    font-size: 0.75rem;
    color: var(--muted);
  }
  ul a:hover {
    color: var(--sl-color-accent);
  }
</style>
