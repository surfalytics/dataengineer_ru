---
import SparkFlowPlayer from './SparkFlowPlayer.astro';
interface Props { mode: 'map-reduce' | 'shuffle' }
const { mode } = Astro.props;
const counts = mode === 'map-reduce';
const cycle = 22; // seconds, including time to read the final state
const lanes = counts ? [
  { input: 'кот · пёс · кот', written: 'кот × 2  ·  пёс × 1', key: 'кот', local: '2', remote: '1', result: '2 + 1 = 3' },
  { input: 'пёс · кот', written: 'пёс × 1  ·  кот × 1', key: 'пёс', local: '1', remote: '1', result: '1 + 1 = 2' },
] : [
  { input: '10:a  ·  11:b', written: 'P0: a  ·  P1: b', key: '10', local: 'a', remote: 'd', result: '10 → {a, d}' },
  { input: '11:c  ·  10:d', written: 'P0: d  ·  P1: c', key: '11', local: 'c', remote: 'b', result: '11 → {b, c}' },
];
const cols = [105, 315];
const moves = [
  { from: 0, to: 0, read: true, start: .04, end: .18, token: 'P0' },
  { from: 1, to: 1, read: true, start: .04, end: .18, token: 'P1' },
  { from: 0, to: 0, read: false, start: .32, end: .46, token: counts ? 'кот × 2' : '10:a' },
  { from: 1, to: 1, read: false, start: .32, end: .46, token: counts ? 'пёс × 1' : '11:c' },
  { from: 0, to: 1, read: false, start: .48, end: .63, token: counts ? 'пёс × 1' : '11:b' },
  { from: 1, to: 0, read: false, start: .65, end: .80, token: counts ? 'кот × 1' : '10:d' },
];
const phases = [
  [0, 'Чтение входных партиций'],
  [.18, counts ? 'Map и локальный подсчёт' : 'Shuffle write · запись блоков'],
  [.32, 'Shuffle read · локальные блоки'],
  [.48, 'По сети · Executor 1 → Executor 2'],
  [.65, 'По сети · Executor 2 → Executor 1'],
  [.80, counts ? 'Reduce · сумма для каждого слова' : 'Одинаковые ключи собраны вместе'],
] as const;
// All SMIL elements use the same SVG clock. Without JS the completed example stays visible.
const clock = { begin: 'indefinite', dur: cycle + 's', repeatCount: 'indefinite' };
function visible(start: number, end = 1) {
  const times = [0], states = [start === 0 ? 'visible' : 'hidden'];
  if (start > 0) { times.push(start); states.push('visible'); }
  if (end < 1) { times.push(end); states.push('hidden'); }
  times.push(1);
  states.push(states[states.length - 1]);
  return { ...clock, attributeName: 'visibility', calcMode: 'discrete', keyTimes: times.join(';'), values: states.join(';') };
}
const routes = moves.map(move => {
  const x = cols[move.from], dest = cols[move.to];
  const path = move.read ? `M ${x} 91 V 140` : `M ${x} 222 C ${x} 270, ${dest} 286, ${dest} 321`;
  return { ...move, path };
});
---
<SparkFlowPlayer title={counts ? 'Как Spark считает слова' : 'Как Spark распределяет записи по ключу'} cycle={cycle}>
  <svg viewBox="0 0 420 441" role="img" aria-label={counts
    ? 'Два executor читают входные партиции, локально считают слова и обмениваются частичными суммами. Итог: кот — 3, пёс — 2.'
    : 'Два executor читают по две записи. Локальные и удалённые блоки с ключом 10 собираются в P0, с ключом 11 в P1.'}>
    {phases.map(([at, title], i) => <text class="phase" x="8" y="21" visibility={i === phases.length - 1 ? 'visible' : 'hidden'}>
      {title}<animate {...visible(at, phases[i + 1]?.[0])} />
    </text>)}
    <defs>
      <marker id={`spark-flow-arrow-${mode}`} viewBox="0 0 8 8" refX="8" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M0 0 L8 4 L0 8 Z" fill="var(--sl-color-gray-4)" />
      </marker>
    </defs>
    {routes.map(route => <path class:list={['route', { remote: route.from !== route.to }]} d={route.path}
      marker-end={`url(#spark-flow-arrow-${mode})`} />)}
    {lanes.map((lane, i) => <g transform={`translate(${cols[i] - 96} 0)`}>
      <rect class="box" y="33" width="192" height="58" rx="8" />
      <text class="name" x="11" y="55">Вход · P{i}</text>
      <text class="data" x="11" y="79">{lane.input}</text>
      <rect class="box" y="140" width="192" height="82" rx="8" />
      <text class="name" x="11" y="162">Executor {i + 1} · task {i}</text>
      <text class="sub" x="11" y="185">{counts ? 'Map + локальная сумма' : 'Блоки для P0 и P1'}</text>
      <text class="data" x="11" y="209">{lane.written}<animate {...visible(.18)} /></text>
      <rect class="box output" y="321" width="192" height="115" rx="8" />
      <text class="name" x="11" y="343">Executor {i + 1} · task {i + 2}</text>
      <text class="sub" x="11" y="365">P{i} · ключ {lane.key}</text>
      <text x="11" y="387">Локально: {lane.local}<animate {...visible(.46)} /></text>
      <text x="11" y="407">По сети: {lane.remote}<animate {...visible(i === 0 ? .80 : .63)} /></text>
      <text class="result" x="11" y="428">{lane.result}<animate {...visible(.80)} /></text>
    </g>)}
    {routes.map(move => <g class="packet" visibility="hidden" aria-hidden="true">
      <rect x="-32" y="-12" width="64" height="24" rx="12" />
      <text y="5" text-anchor="middle">{move.token}</text>
      <animate {...visible(move.start, move.end)} />
      <animateMotion {...clock} path={move.path} calcMode="linear" keyPoints="0;0;1;1"
        keyTimes={`0;${move.start};${move.end};1`} />
    </g>)}
  </svg>
</SparkFlowPlayer>

<style>
  svg { display:block; width:100%; height:auto; }
  text { fill:var(--sl-color-text); font:15px var(--sl-font); }
  .phase, .result { fill:var(--sl-color-text-accent); font-weight:650; }
  .box { fill:var(--sl-color-bg); stroke:var(--sl-color-gray-5); }
  .output { stroke:var(--sl-color-accent); }
  .name { fill:var(--sl-color-white); font-weight:650; }
  .sub { fill:var(--sl-color-gray-2); }
  .data, .result { font-family:var(--sl-font-mono); }
  .route { fill:none; stroke:var(--sl-color-gray-4); stroke-width:1.5; }
  .remote { stroke-dasharray:4 4; }
  .packet rect { fill:var(--sl-color-accent-low); stroke:var(--sl-color-accent); }
  .packet text { fill:var(--sl-color-accent-high); font:600 14px var(--sl-font-mono); }
</style>
