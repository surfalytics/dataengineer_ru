---
import {transactionScenes} from './transaction-scenes';
const {topic} = Astro.props as {topic: keyof typeof transactionScenes};
const variants = transactionScenes[topic];
const first = variants[0];
const frame = first.frames[0];
---
<transaction-demo class="demo not-content" data-scenes={JSON.stringify(variants)}>
  <div class="toolbar"><strong>{topic === 'mvcc' ? 'Один SELECT — один снимок' : 'Кто может писать'}</strong><button type="button" data-play hidden>Пауза</button></div>
  <fieldset class="switcher"><legend>{topic === 'mvcc' ? 'Уровень изоляции сеанса A' : 'Область блокировки'}</legend>
    {variants.map((v,i)=><label><input type="radio" name={`tx-${topic}`} value={i} checked={i===0}/><span>{v.label}</span></label>)}
  </fieldset>
  <div class="grid actors">
    {([frame.a,frame.b]).map((side,i)=><div class="actor" data-actor data-tone={side.tone}>
      <div class="label">Сеанс {i===0?'A':'B'} · <span data-role>{first.actors[i]}</span></div>
      <strong class="command" data-text>{side.text}</strong><p data-detail>{side.detail}</p>
    </div>)}
  </div>
  <div class="flow" aria-label="Связь между событиями">
    {frame.path.map((part,i)=><><span class="stop" data-stop>{part}</span>{i<2 && <span class="arrow" aria-hidden="true"></span>}</>)}
  </div>
  <div class="label group-title" data-res-title>{first.resourceLabel}</div>
  <div class="grid versions">
    {frame.resources.map(r=><div class="resource" data-resource data-tone={r.tone}><strong data-text>{r.text}</strong><p data-detail>{r.detail}</p></div>)}
  </div>
  <div class="caption"><strong data-heading>{frame.title}</strong><p data-note>{frame.note}</p></div>
</transaction-demo>
<script>
  import type {transactionScenes, TxFrame} from './transaction-scenes';
  type Variant = (typeof transactionScenes)['mvcc'][number];
  class TransactionDemo extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback(){
      const variants: Variant[]=JSON.parse(this.dataset.scenes!);
      const toggles=[...this.querySelectorAll<HTMLInputElement>('input[type=radio]')];
      const play=this.querySelector<HTMLButtonElement>('[data-play]')!;
      const roles=this.querySelectorAll('[data-role]');
      const actors=this.querySelectorAll<HTMLElement>('[data-actor]');
      const resources=this.querySelectorAll<HTMLElement>('[data-resource]');
      const stops=this.querySelectorAll('[data-stop]');
      const label=this.querySelector('[data-res-title]')!;
      const heading=this.querySelector('[data-heading]')!;
      const note=this.querySelector('[data-note]')!;
      const flow=this.querySelector('.flow')!;
      const handlers=new AbortController();
      const options={signal:handlers.signal};
      let variant = 0;
      let current = 0;
      let paused = false;
      let timer: number | undefined;
      const cell=(where: HTMLElement, data: TxFrame['a'])=>{
        where.dataset.tone=data.tone;
        where.querySelector('[data-text]')!.textContent=data.text;
        where.querySelector('[data-detail]')!.textContent=data.detail;
      };
      const render=()=>{
        const scene=variants[variant], f=scene.frames[current];
        this.dataset.variant=String(variant); this.dataset.frame=String(current);
        [f.a,f.b].forEach((side,i)=>{roles[i].textContent=scene.actors[i];cell(actors[i],side);});
        f.resources.forEach((r,i)=>cell(resources[i],r));
        f.path.forEach((s,i)=>{stops[i].textContent=s;});
        label.textContent=scene.resourceLabel;
        flow.toggleAttribute('data-wait',f.waiting);
        heading.textContent=f.title;
        note.textContent=f.note;
      };
      const sync=()=>{
        window.clearInterval(timer);
        this.toggleAttribute('data-paused',paused || document.hidden);
        if(!paused && !document.hidden)timer=window.setInterval(()=>{
          current=(current+1)%variants[variant].frames.length;render();
        },800);
      };
      for(const radio of toggles) radio.addEventListener('change',()=>{
        variant=Number(radio.value);current=0;render();sync();
      },options);
      play.addEventListener('click',()=>{
        paused=!paused;play.textContent=paused?'Продолжить':'Пауза';sync();
      },options);
      document.addEventListener('visibilitychange',sync,options);
      render();play.hidden=false;sync();
      this.cleanup=()=>{window.clearInterval(timer);handlers.abort();};
    }
    disconnectedCallback(){this.cleanup?.();}
  }
  if(!customElements.get('transaction-demo'))customElements.define('transaction-demo',TransactionDemo);
</script>
<style>
  .demo {display:block;max-width:48rem;container-type:inline-size;padding:clamp(.8rem,2.4vw,1.4rem);margin-block:1.25rem;border:1px solid var(--sl-color-gray-5);border-radius:.6rem;background:var(--sl-color-bg);}
  .toolbar {display:flex;align-items:center;justify-content:space-between;gap:1rem;}
  .toolbar strong {font-size:1.05rem;color:var(--sl-color-white);}
  button,.switcher span {font:inherit;font-size:.85rem;border:1px solid var(--sl-color-gray-5);border-radius:.35rem;color:var(--sl-color-text);background:var(--sl-color-bg);cursor:pointer;}
  button {padding:.4rem .7rem;min-height:2.4rem;}
  button:hover,.switcher label:hover span {border-color:var(--sl-color-accent);}
  .switcher {padding:0;border:0;margin:.55rem 0 1rem;display:flex;flex-wrap:wrap;gap:.4rem;}
  legend,.label {font-size:.8rem;color:var(--sl-color-gray-3);line-height:1.5;}
  legend {margin-bottom:.35rem;}
  .switcher label {position:relative;} .switcher span {display:block;padding:.35rem .6rem;}
  .switcher input {position:absolute;opacity:0;width:1px;height:1px;}
  .switcher input:checked+span {background:var(--sl-color-accent-low);border-color:var(--sl-color-accent);color:var(--sl-color-accent-high);}
  .switcher input:focus-visible+span {outline:2px solid var(--sl-color-accent);outline-offset:2px;}
  .grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;}
  .actor,.resource {border:1px solid var(--sl-color-gray-5);border-radius:.4rem;padding:.6rem .7rem;overflow-wrap:anywhere;}
  .actor {min-height:6.2rem;} .resource {min-height:4.8rem;}
  .actor strong,.resource strong {display:block;color:var(--sl-color-white);font:600 .9rem/1.5 var(--sl-font-mono);}
  .actor .label {margin-bottom:.3rem;}
  .demo p {margin:.24rem 0 0;line-height:1.45;font-size:.9rem;}
  [data-tone="active"],[data-tone="done"] {border-color:var(--sl-color-accent);background:var(--sl-color-accent-low);}
  [data-tone="wait"] {border:1px dashed light-dark(#805a0c,#dbba70);background:light-dark(#faf3df,#2b2519);}
  .flow {display:grid;grid-template-columns:minmax(0,1fr) 1.5rem minmax(0,1fr) 1.5rem minmax(0,1fr);align-items:center;gap:.4rem;margin:.9rem 0;}
  .stop {font-size:.83rem;text-align:center;color:var(--sl-color-white);padding:.3rem .1rem;line-height:1.3;overflow-wrap:anywhere;}
  .arrow {position:relative;height:1px;background:var(--sl-color-gray-4);}
  .arrow::after {content:'';position:absolute;right:0;top:-3px;width:5px;height:5px;border-top:1px solid var(--sl-color-gray-3);border-right:1px solid var(--sl-color-gray-3);transform:rotate(45deg);}
  .arrow::before {content:'';position:absolute;top:-2px;left:0;width:5px;height:5px;border-radius:50%;background:var(--sl-color-accent);animation:travel .8s linear infinite;}
  @keyframes travel {to {left:calc(100% - 5px);}}
  .flow[data-wait] .arrow::before {display:none;} .flow[data-wait] .stop:nth-child(3) {color:light-dark(#805a0c,#dbba70);}
  .demo[data-paused] .arrow::before {animation-play-state:paused;}
  @media(prefers-reduced-motion:reduce){.arrow::before {display:none;}}
  .group-title {margin:.55rem 0 .35rem;}
  .caption {border-top:1px solid var(--line);margin-top:.9rem;padding-top:.65rem;min-height:4.75rem;}
  .caption strong {color:var(--sl-color-white);}
  @container(max-width:24rem) {
    .grid {gap:.4rem;} .actor,.resource {padding:.45rem;} .actor{min-height:8rem;} .resource{min-height:6.5rem;}
    .flow{grid-template-columns:minmax(0,1fr) .75rem minmax(0,1fr) .75rem minmax(0,1fr);gap:.15rem;}
    .stop {font-size:.76rem;} .caption {min-height:6rem;}
  }
</style>
