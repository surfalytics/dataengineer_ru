---
import SparkFlowPlayer from './SparkFlowPlayer.astro';

interface Props { strategy: 'broadcast' | 'merge' | 'shuffle-hash' }
const { strategy } = Astro.props;
const broadcast = strategy === 'broadcast';
const merge = strategy === 'merge';
const titles = { broadcast: 'BroadcastHashJoin', merge: 'SortMergeJoin', 'shuffle-hash': 'ShuffledHashJoin' };
const title = titles[strategy];
const description = broadcast
  ? 'Каждая задача получает весь справочник из трёх магазинов и обрабатывает свою исходную партицию заказов.'
  : merge
    ? 'Заказы и магазины распределяются по ключу. Каждая задача сортирует обе свои партиции и соединяет строки с равными ключами.'
    : 'Заказы и магазины распределяются по ключу. Каждая задача строит хеш-таблицу по своей части справочника и ищет в ней ключ каждого заказа.';

const orders = broadcast ? ['A·3, B·2', 'C·1, D·2'] : merge ? ['C·1, A·3', 'B·2, D·2'] : ['A·3, C·1', 'B·2, D·2'];
const shops = broadcast ? ['3, 1, 2', '3, 1, 2'] : merge ? ['1, 3', '2'] : ['3, 1', '2'];
const results = broadcast
  ? [['A → Томск', 'B → Пермь'], ['C → Омск', 'D → Пермь']]
  : [merge ? ['C → Омск', 'A → Томск'] : ['A → Томск', 'C → Омск'], ['B → Пермь', 'D → Пермь']];

const cycle = 19;
const clock = { begin: 'indefinite', dur: cycle + 's', repeatCount: 'indefinite' };
const centers = [94, 286];
const sources = [
  ['Заказы', 'A·3   B·2', 'C·1   D·2'],
  ['Магазины', '3 Томск   1 Омск', '2 Пермь'],
];
const packets = [
  { from: 1, to: 0, label: broadcast ? 'все магазины' : 'ключи 3, 1', start: .08, end: .25 },
  { from: 1, to: 1, label: broadcast ? 'все магазины' : 'ключ 2', start: .08, end: .25 },
  { from: 0, to: 0, label: broadcast ? 'A·3  B·2' : 'A·3  C·1', start: .29, end: .47 },
  { from: 0, to: 1, label: broadcast ? 'C·1  D·2' : 'B·2  D·2', start: .29, end: .47 },
].map(packet => ({
  ...packet,
  path: `M${centers[packet.from]} 120 C${centers[packet.from]} 161 ${centers[packet.to]} 167 ${centers[packet.to]} 205`,
}));
const phases = [
  [0, 'Читаем заказы и справочник'],
  [.08, broadcast ? 'Broadcast всего справочника' : 'Shuffle магазинов по ключу'],
  [.29, broadcast ? 'Заказы остаются в своих партициях' : 'Shuffle заказов по тому же ключу'],
  [.49, broadcast ? 'Ищем ключ в копии справочника' : merge ? 'Сортируем обе стороны внутри задачи' : 'Строим хеш по своей части справочника'],
  [.68, merge ? 'Сопоставляем отсортированные ключи' : 'Находим город по ключу заказа'],
  [.86, 'Четыре заказа получили свои города'],
] as const;
function visible(from: number, until = 1) {
  const times = [0], values = [from === 0 ? 'visible' : 'hidden'];
  if (from > 0) { times.push(from); values.push('visible'); }
  if (until < 1) { times.push(until); values.push('hidden'); }
  times.push(1);
  values.push(values[values.length - 1]);
  return { ...clock, attributeName: 'visibility', calcMode: 'discrete', keyTimes: times.join(';'), values: values.join(';') };
}
---
<SparkFlowPlayer title={title} cycle={cycle}>
  <svg viewBox="0 0 380 385" role="img" aria-label={description}>
    {phases.map(([start, phase], i) => <text class="phase" x="6" y="23" visibility={i === phases.length - 1 ? 'visible' : 'hidden'}>
      {phase}<animate {...visible(start, phases[i + 1]?.[0])} />
    </text>)}
    {sources.map(([name, row1, row2], i) => <g transform={`translate(${centers[i] - 88} 40)`}>
      <rect class="box" width="176" height="80" rx="7" />
      <text class="heading" x="12" y="22">{name}</text>
      <text x="12" y="46">{row1}</text>
      <text x="12" y="67">{row2}</text>
    </g>)}
    {packets.map(({path, from}) => <path class:list={['route', { shops: from === 1 }]} d={path} />)}
    {orders.map((orderKeys, i) => <g transform={`translate(${centers[i] - 88} 205)`}>
      <rect class="box" width="176" height="174" rx="7" />
      <text class="heading" x="12" y="23">Задача {i + 1}</text>
      <g><animate {...visible(.49)} />
        <text class="operation" x="12" y="48">{broadcast ? 'Копия справочника' : merge ? 'После сортировки' : 'Хеш по партиции'}</text>
        <text x="12" y="71">{merge ? 'Магазины' : 'Ключи хеша'}: {shops[i]}</text>
        <text x="12" y="93">Заказы: {orderKeys}</text>
      </g>
      <path class="divider" d="M12 107 H164" />
      {results[i].map((result, j) => <text class="result" x="12" y={133 + j * 25}>
        {result}<animate {...visible(j === 0 ? .68 : .86)} />
      </text>)}
    </g>)}
    {packets.map(({path, from, label, start, end}) => <g class:list={['packet', { shops: from === 1 }]} visibility="hidden" aria-hidden="true">
      <rect x="-51" y="-11" width="102" height="22" rx="11" />
      <text y="4" text-anchor="middle">{label}</text>
      <animate {...visible(start, end)} />
      <animateMotion {...clock} path={path} calcMode="linear" keyPoints="0;0;1;1" keyTimes={`0;${start};${end};1`} />
    </g>)}
  </svg>
</SparkFlowPlayer>

<style>
  svg { display: block; width: 100%; height: auto; }
  text { font: 14px var(--sl-font); fill: var(--sl-color-text); }
  .phase, .result { font-weight: 650; fill: var(--sl-color-text-accent); }
  .heading { font-weight: 650; fill: var(--sl-color-white); }
  .operation { font-weight: 600; }
  .box { fill: var(--sl-color-bg); stroke: var(--sl-color-gray-4); }
  .route, .divider { fill: none; stroke: var(--sl-color-gray-4); }
  .route { stroke-width: 1.6; }
  .route.shops { stroke-dasharray: 4 4; }
  .packet rect { fill: var(--sl-color-bg); stroke: var(--sl-color-gray-3); }
  .packet.shops rect { fill: var(--sl-color-accent-low); stroke: var(--sl-color-text-accent); }
  .packet text { font-size: 12px; font-weight: 650; }
</style>
